{
  "name": "bullmq-hono-dashboard",
  "version": "1.0.0",
  "description": "Production-ready BullMQ dashboard with Hono and JWT authentication",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "bullmq",
    "hono",
    "bull-board",
    "redis",
    "job-queue",
    "dashboard",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/hono": "^6.0.0",
    "@hono/node-server": "^1.13.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "mysql2": "^3.11.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
