# Server
NODE_ENV=development
PORT=3000

# Redis (docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# Database (docker-compose defaults)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=job_dashboard
DB_CONNECTION_LIMIT=10

# Authentication
SESSION_SECRET=dev-secret-key-change-in-production-min-32-chars

# Dashboard
DASHBOARD_BASE_PATH=/admin/queues
